# Required credentials: fill privately in .env; do not commit them.
BANK_KEY=
DEVICE_KEY=

# Example budget and alert settings.
BUDGET_PERMONTH=15000000
BUDGET_ALERT_PERCENT=80
NOTIFICATION_MODE=all

# Optional Bark notification settings.
ICON_URL=
BARK_SOUND=

# Optional: enable dashboard label edits. Use a random value of at least 16 characters.
# DASHBOARD_WRITE_KEY=
